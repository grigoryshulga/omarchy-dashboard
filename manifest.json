{
  "schemaVersion": 1,
  "id": "gshulga.dashboard",
  "name": "Dashboard",
  "version": "1.6.6",
  "author": "gshulga",
  "description": "A keyboard-first grid for embedded, popout, and control tiles from unchanged Omarchy plugins.",
  "license": "MIT",
  "kinds": ["panel", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Dashboard.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Dashboard",
    "description": "Open the Omarchy plugin dashboard",
    "category": "System",
    "defaultSection": "left",
    "allowMultiple": false,
    "defaults": {
      "showLabel": false,
      "dimBackground": true,
      "surfaceMode": "Glass",
      "blurBackground": true
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show label",
        "description": "Show Dashboard text next to the bar icon.",
        "defaultValue": false
      },
      {
        "key": "dimBackground",
        "type": "boolean",
        "label": "Dim background",
        "description": "Dim the desktop behind Dashboard.",
        "defaultValue": true
      },
      {
        "key": "surfaceMode",
        "type": "enum",
        "label": "Surface mode",
        "description": "Framed keeps the classic card; Glass uses the current wallpaper across the full screen.",
        "options": ["Framed", "Glass"],
        "defaultValue": "Glass"
      },
      {
        "key": "blurBackground",
        "type": "boolean",
        "label": "Blur wallpaper",
        "description": "Blur the current Omarchy wallpaper using live Hyprland blur values.",
        "defaultValue": true
      }
    ]
  }
}
